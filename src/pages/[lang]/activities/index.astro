---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Pagination from '../../../components/Pagination.astro';
import { t } from '../../../i18n/utils';
import { isValidLocale, locales, type Locale } from '../../../i18n/config';
import { getDb } from '../../../lib/db';
import { activities, activitiesContent } from '../../../db/schema';
import { and, count, desc, eq } from 'drizzle-orm';
import { env } from 'cloudflare:workers';
import { richTextToPlainText } from '../../../lib/rich-text';
import { getActivityImageUrl } from '../../../lib/r2';

const langParam = Astro.params.lang as string;
if (!isValidLocale(langParam)) return Astro.redirect('/zh/activities/');
const lang = langParam as Locale;
const db = getDb(env.DB);
const pageSize = 12;
const pageParam = Astro.url.searchParams.get('page');
const categoryParam = Astro.url.searchParams.get('category');
const currentPage = pageParam && /^\d+$/.test(pageParam) ? Number(pageParam) : 1;

if (categoryParam) {
  return Astro.redirect(
    `/${lang}/activities/${currentPage > 1 ? `?page=${currentPage}` : ''}`,
    301,
  );
}

const basePath = `/${lang}/activities/`;
const pageHref = (page: number) => {
  const params = new URLSearchParams();
  if (page > 1) params.set('page', String(page));
  const search = params.toString();
  return `${basePath}${search ? `?${search}` : ''}`;
};

if (currentPage < 1 || (pageParam !== null && (currentPage === 1 || !/^\d+$/.test(pageParam)))) {
  return Astro.redirect(pageHref(1), 301);
}

const [{ total }] = await db
  .select({ total: count() })
  .from(activities)
  .innerJoin(
    activitiesContent,
    and(eq(activitiesContent.activity_id, activities.id), eq(activitiesContent.lang, lang)),
  )
  .where(eq(activities.is_active, true));
const totalPages = Math.max(1, Math.ceil(total / pageSize));
if (currentPage > totalPages) {
  return Astro.redirect(pageHref(totalPages), 302);
}

const activityRows = await db.select({
  id: activities.id,
  slug: activitiesContent.slug,
  featuredImageKey: activities.featured_image_key,
  publishedAt: activities.published_at,
  isFeatured: activities.is_featured,
  viewCount: activities.view_count,
  title: activitiesContent.title,
  description: activitiesContent.description,
  content: activitiesContent.content,
}).from(activities).innerJoin(
  activitiesContent,
  and(eq(activitiesContent.activity_id, activities.id), eq(activitiesContent.lang, lang)),
).where(eq(activities.is_active, true))
  .orderBy(desc(activities.is_featured), desc(activities.published_at))
  .limit(pageSize)
  .offset((currentPage - 1) * pageSize);

const allActivities = activityRows.map((row) => {
  const plain = richTextToPlainText(row.content || '');
  const readingMinutes = Math.max(
    1,
    Math.ceil(
      lang === 'zh'
        ? plain.replace(/\s+/g, '').length / 400
        : plain.split(/\s+/).filter(Boolean).length / 200,
    ),
  );
  return {
    id: row.id,
    slug: row.slug,
    featuredImage: getActivityImageUrl(row.featuredImageKey),
    publishedAt: row.publishedAt,
    isFeatured: row.isFeatured,
    viewCount: row.viewCount,
    title: row.title,
    description: row.description || '',
    content: row.content || '',
    readingMinutes,
  };
});

const siteName = t(lang, 'site.brand');
const paginationSuffix = currentPage > 1
  ? t(lang, 'common.pageSuffix', { page: currentPage })
  : '';
const pageTitle = t(lang, 'activities.seoTitle', { page: paginationSuffix });
const pageDesc = t(lang, 'activities.seoDescription');
const siteUrl = Astro.site!.href.replace(/\/$/, '');
const canonicalUrl = `${siteUrl}${pageHref(currentPage)}`;
const alternateSuffix = canonicalUrl.slice(`${siteUrl}${basePath}`.length);
const alternates = locales.map((locale) => ({ lang: locale, href: `${siteUrl}/${locale}/activities/${alternateSuffix}` }));
const prevUrl = currentPage > 1 ? `${siteUrl}${pageHref(currentPage - 1)}` : undefined;
const nextUrl = currentPage < totalPages ? `${siteUrl}${pageHref(currentPage + 1)}` : undefined;
const socialImage = allActivities.find((item) => item.featuredImage)?.featuredImage;
const absoluteSocialImage = socialImage ? `${siteUrl}${socialImage}` : `${siteUrl}/og-image.png`;
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'CollectionPage', name: pageTitle, description: pageDesc,
  url: canonicalUrl, inLanguage: lang,
  mainEntity: {
    '@type': 'ItemList', numberOfItems: total,
    itemListElement: allActivities.map((activity, index) => ({
      '@type': 'ListItem', position: (currentPage - 1) * pageSize + index + 1,
      item: {
        '@type': 'Article', headline: activity.title,
        description: activity.description || richTextToPlainText(activity.content).slice(0, 160),
        url: `${siteUrl}/${lang}/activity/${activity.slug}/`, datePublished: activity.publishedAt,
        ...(activity.featuredImage && { image: `${siteUrl}${activity.featuredImage}` }),
      },
    })),
  },
};
---

<BaseLayout
  title={`${pageTitle} - ${siteName}`}
  description={pageDesc}
  lang={lang}
  alternates={alternates}
  jsonLd={jsonLd}
  xDefault={`${siteUrl}/zh/activities/${alternateSuffix}`}
  canonical={canonicalUrl}
  prev={prevUrl}
  next={nextUrl}
  image={absoluteSocialImage}
  twitterCard={socialImage ? 'summary_large_image' : 'summary'}
>
  <section class="hero">
    <div class="hero-grid">
      <div>
        <p class="eyebrow">{t(lang, 'activities.eyebrow')}</p>
        <h1 class="hero-title">{t(lang, 'activities.heroTitle')}</h1>
        <p
          class="hero-copy"
          set:html={t(lang, 'activities.heroCopy', {
            total: `<span class="mono">${total}</span>`,
          })}
        />
        <div class="hero-actions">
          <a class="btn" href="#activity-list">{t(lang, 'activities.browse')}</a>
          <a class="text-link" href={`/${lang}/methodology/`}>
            {t(lang, 'common.method')} →
          </a>
        </div>
      </div>

      <div class="hero-facts" aria-label={t(lang, 'activities.factsAria')}>
        <div class="fact-row">
          <span class="fact-label">{t(lang, 'common.total')}</span>
          <span class="fact-value">{String(total).padStart(2, '0')}</span>
        </div>
        <div class="fact-row">
          <span class="fact-label">{t(lang, 'common.page')}</span>
          <span class="fact-value">{String(currentPage).padStart(2, '0')} / {String(totalPages).padStart(2, '0')}</span>
        </div>
        <div class="fact-row">
          <span class="fact-label">{t(lang, 'common.latest')}</span>
          <span class="fact-value">
            {allActivities[0] ? allActivities[0].publishedAt.slice(0, 10) : '—'}
          </span>
        </div>
      </div>
    </div>
  </section>

  <section class="section-gap" id="activity-list">
    <div class="section-head">
      <h2 class="section-title">{t(lang, 'activities.all')}</h2>
      <div class="section-side">
        <span class="section-count">{String(allActivities.length).padStart(2, '0')} / {String(total).padStart(2, '0')}</span>
      </div>
    </div>

    {allActivities.length > 0 ? (
      <div class="hair-grid">
        {allActivities.map((activity) => (
          <article class="card">
            {activity.featuredImage && (
              <div class="card-media">
                <img
                  src={activity.featuredImage}
                  alt=""
                  width="720"
                  height="405"
                  loading="lazy"
                />
              </div>
            )}
            <span class="card-eyebrow">
              {activity.isFeatured && <>{t(lang, 'common.featured')} · </>}
              {activity.publishedAt.slice(0, 10)}
            </span>
            <h2 class="card-title">
              <a href={`/${lang}/activity/${activity.slug}/`} class="stretched-link">{activity.title}</a>
            </h2>
            <p class="card-desc">
              {activity.description || richTextToPlainText(activity.content).slice(0, 150)}
            </p>
            <div class="card-metrics">
              <span class="card-metric-value">{activity.viewCount}</span>
              <span class="card-metric-label">{t(lang, 'common.views')}</span>
            </div>
            <div class="card-footer">
              <span class="card-fact">
                {t(lang, 'common.readingTime', { count: activity.readingMinutes })}
              </span>
              <span class="card-arrow" aria-hidden="true">→</span>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <p class="empty-state">{t(lang, 'activities.empty')}</p>
    )}
  </section>

  <Pagination currentPage={currentPage} totalPages={totalPages} basePath={basePath} lang={lang} />
</BaseLayout>
