---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProviderCard from '../../components/ProviderCard.astro';
import { isValidLocale, locales, type Locale } from '../../i18n/config';
import { t } from '../../i18n/utils';
import { getDb } from '../../lib/db';
import { getCached, setCache } from '../../lib/cache';
import { providers, providersContent } from '../../db/schema';
import { eq, and, desc } from 'drizzle-orm';
import { env } from 'cloudflare:workers';
import { richTextToPlainText } from '../../lib/rich-text';
import { getLogoUrl } from '../../lib/r2';
import { isProviderCategory, providerCategories } from '../../lib/provider-categories';

const HOMEPAGE_CATEGORY_LIMIT = 9;

const lang = Astro.params.lang as string;
if (!isValidLocale(lang)) {
  return new Response('Not Found', {
    status: 404,
    headers: { 'content-type': 'text/plain; charset=utf-8' },
  });
}

const db = getDb(env.DB);

// Try KV cache first
const cacheKey = `home:${lang}`;
type ProviderRow = {
  providers: typeof providers.$inferSelect;
  providers_content: typeof providersContent.$inferSelect | null;
};
let data = await getCached<ProviderRow[]>(env.VPSDIR_KV, cacheKey);

if (!data) {
  const rows = await db
    .select()
    .from(providers)
    .leftJoin(
      providersContent,
      and(eq(providers.id, providersContent.provider_id), eq(providersContent.lang, lang)),
    )
    .where(eq(providers.is_active, true))
    .orderBy(providers.category, desc(providers.id));

  data = rows;
  await setCache(env.VPSDIR_KV, cacheKey, data);
}

// Cached payloads created by older deployments may use ascending IDs. Sort again
// at render time so "latest six" remains correct until those KV entries expire.
data.sort((left, right) => right.providers.id - left.providers.id);

// Legacy rows may lack a translation for this locale; never link to a page
// that would 404.
type LocalizedProviderRow = ProviderRow & {
  providers_content: NonNullable<ProviderRow['providers_content']>;
};
const localizedData = data.filter(
  (row): row is LocalizedProviderRow => row.providers_content !== null,
);

// Group by category
const categories = new Map<string, LocalizedProviderRow[]>();
for (const row of localizedData) {
  const cat = row.providers.category;
  if (!categories.has(cat)) categories.set(cat, []);
  categories.get(cat)!.push(row);
}
const categoryOrder = new Map(providerCategories.map((category, index) => [category, index]));
const categoryEntries = Array.from(categories.entries()).sort(([left], [right]) =>
  (categoryOrder.get(left as typeof providerCategories[number]) ?? Number.MAX_SAFE_INTEGER)
  - (categoryOrder.get(right as typeof providerCategories[number]) ?? Number.MAX_SAFE_INTEGER));

const siteUrl = Astro.site!.href.replace(/\/$/, '');
const alternates = locales.map((l) => ({ lang: l, href: `${siteUrl}/${l}/` }));

// Prepare data for client-side search. Only send fields the client actually
// renders so the inline payload stays small as the directory grows.
const providerSearchData = categoryEntries.flatMap(([cat, items]) =>
  items.map(item => ({
    category: cat,
    providers: {
      slug_zh: item.providers.slug_zh,
      slug_en: item.providers.slug_en,
      logo_url: item.providers.logo_key
        ? getLogoUrl(item.providers.logo_key, item.providers.updated_at)
        : null,
      rating: item.providers.rating,
      tags: item.providers.tags,
      updated_at: item.providers.updated_at,
    },
    providers_content: item.providers_content
      ? {
          name: item.providers_content.name,
          desc: richTextToPlainText(item.providers_content.desc).slice(0, 300),
        }
      : null,
  })));
const homepageProviderData = categoryEntries.flatMap(([, items]) => items.slice(0, HOMEPAGE_CATEGORY_LIMIT));

const pad = (value: number) => String(value).padStart(2, '0');
const totalProviders = localizedData.length;
const totalCategories = categories.size;
const lastReviewed = localizedData.reduce(
  (latest, row) => (row.providers.updated_at > latest ? row.providers.updated_at : latest),
  '',
).slice(0, 10);

// Tags may be stored as plain strings or bilingual objects. Collect both
// language labels so the curated filters appear on /zh/ and /en/ alike.
const allTagKeys = new Set<string>();
for (const row of localizedData) {
  if (!row.providers.tags) continue;
  try {
    const parsed = JSON.parse(row.providers.tags);
    for (const tag of parsed) {
      if (typeof tag === 'string') {
        if (tag) allTagKeys.add(tag);
        continue;
      }
      if (tag.zh) allTagKeys.add(tag.zh);
      if (tag.en) allTagKeys.add(tag.en);
    }
  } catch {
    // Ignore malformed legacy tag JSON rather than breaking the homepage.
  }
}
// Keep the homepage filter focused. Provider records retain their full tags so
// free-text search and detail pages still expose every useful attribute.
const selectedTagDefinitions = [
  { value: '低价VPS', zh: '低价VPS', en: 'Budget VPS' },
  { value: '美国', zh: '美国', en: 'United States' },
  { value: '香港', zh: '香港', en: 'Hong Kong' },
  { value: 'CN2 GIA', zh: 'CN2 GIA', en: 'CN2 GIA' },
  { value: '中国优化', zh: '中国优化', en: 'China Optimized' },
  { value: '住宅IP', zh: '住宅IP', en: 'Residential IP' },
  { value: '原生IP', zh: '原生IP', en: 'Native IP' },
  { value: 'AMD EPYC', zh: 'AMD EPYC', en: 'AMD EPYC' },
  { value: 'NVMe', zh: 'NVMe', en: 'NVMe' },
  { value: 'Windows', zh: 'Windows', en: 'Windows' },
] as const;
const homepageTags = selectedTagDefinitions.filter(
  (tag) => allTagKeys.has(tag.zh) || allTagKeys.has(tag.en),
);

const homeJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: t(lang as Locale, 'site.brand'),
  description: t(lang as Locale, 'site.description'),
  url: `${siteUrl}/${lang}/`,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${siteUrl}/${lang}/?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: t(lang as Locale, 'site.brand'),
  url: `${siteUrl}/${lang}/`,
  description: t(lang as Locale, 'site.description'),
};

const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: t(lang as Locale, 'home.listedName'),
  numberOfItems: homepageProviderData.length,
  itemListElement: homepageProviderData.map((item, index) => {
    const slug = lang === 'zh' ? item.providers.slug_zh : item.providers.slug_en;
    return {
      '@type': 'ListItem',
      position: index + 1,
      url: `${siteUrl}/${lang}/provider/${slug}/`,
      name: item.providers_content.name,
    };
  }),
};
---

<BaseLayout
  title={t(lang, 'site.title')}
  description={t(lang, 'site.description')}
  lang={lang as Locale}
  alternates={alternates}
  jsonLd={homeJsonLd}
  extraJsonLd={[orgJsonLd, itemListJsonLd]}
>
  <section class="hero">
    <div class="hero-grid">
      <div>
        <p class="eyebrow">{t(lang, 'home.eyebrow')}</p>
        <h1 class="hero-title">
          {t(lang, 'home.title')}
        </h1>
        <p
          class="hero-copy"
          set:html={t(lang, 'home.heroCopy', {
            providers: `<span class="mono">${totalProviders}</span>`,
            categories: `<span class="mono">${totalCategories}</span>`,
          })}
        />

        <div class="hero-actions">
          <a class="btn" href="#directory">{t(lang, 'home.browse')}</a>
          <a class="text-link" href={`/${lang}/methodology/`}>
            {t(lang, 'common.method')} →
          </a>
        </div>

        <div class="directory-search">
          <div class="search-row">
            <label class="sr-only" for="search-input">
              {t(lang, 'home.searchLabel')}
            </label>
            <input
              type="text"
              id="search-input"
              placeholder={t(lang, 'home.searchLabel')}
              class="input"
            />
            <button id="search-button" type="button" class="btn">
              {t(lang, 'home.search')}
            </button>
            <button id="clear-button" type="button" class="search-clear">
              {t(lang, 'home.clear')}
            </button>
          </div>
          <div id="search-tags" class="filter-tags">
            {homepageTags.map((tag) => (
              <button
                type="button"
                class="tag-btn"
                data-tag={tag.value}
                aria-pressed="false"
              >
                {tag[lang]}
              </button>
            ))}
          </div>
        </div>
      </div>

      <div class="hero-facts" aria-label={t(lang, 'home.factsAria')}>
        <div class="fact-row">
          <span class="fact-label">{t(lang, 'home.providersFact')}</span>
          <span class="fact-value">{pad(totalProviders)}</span>
        </div>
        <div class="fact-row">
          <span class="fact-label">{t(lang, 'home.categoriesFact')}</span>
          <span class="fact-value">{pad(totalCategories)}</span>
        </div>
        <div class="fact-row">
          <span class="fact-label">{t(lang, 'home.lastReviewed')}</span>
          <span class="fact-value">{lastReviewed || '—'}</span>
        </div>
      </div>
    </div>
  </section>

  <div id="directory">
    <div id="provider-container">
      {categories.size === 0 && (
        <p class="empty-state">{t(lang, 'home.empty')}</p>
      )}

      {categoryEntries.map(([category, items]) => (
        <section class="section-gap">
          <div class="section-head">
            <h2 class="section-title">{t(lang, `categories.${category}`)}</h2>
            <div class="section-side">
              <span class="section-count">{pad(Math.min(items.length, HOMEPAGE_CATEGORY_LIMIT))} / {pad(items.length)}</span>
              {isProviderCategory(category) && (
                <a href={`/${lang}/category/${category}/`} class="section-link">
                  {t(lang, 'home.viewAll')} →
                </a>
              )}
            </div>
          </div>
          <div class="hair-grid">
            {items.slice(0, HOMEPAGE_CATEGORY_LIMIT).map((row) => (
              <ProviderCard
                provider={row.providers}
                content={row.providers_content}
                lang={lang as Locale}
              />
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>

  <script define:vars={{
    data: JSON.stringify(providerSearchData),
    lang,
    categoryLabels: JSON.stringify(Object.fromEntries(providerCategories.map((category) => [category, t(lang, `categories.${category}`)]))),
    categoryPaths: JSON.stringify(Object.fromEntries(providerCategories.map((category) => [category, `/${lang}/category/${category}/`]))),
    tagFilters: JSON.stringify(Object.fromEntries(selectedTagDefinitions.map((tag) => [tag.value, [tag.zh, tag.en]]))),
    viewAllLabel: t(lang, 'home.viewAll'),
    categoryLimit: HOMEPAGE_CATEGORY_LIMIT,
    emptyLabel: t(lang, 'home.noMatch'),
    emptyHintLabel: t(lang, 'home.noMatchHint'),
    clearFiltersLabel: t(lang, 'home.clearFilters'),
    uiLabelsJson: JSON.stringify({
      editorial: t(lang, 'home.editorial'),
      updated: t(lang, 'common.updated'),
      viewDetails: t(lang, 'home.viewDetails'),
    }),
  }}>
    const allProviders = JSON.parse(data);
    const localizedCategoryLabels = JSON.parse(categoryLabels);
    const localizedCategoryPaths = JSON.parse(categoryPaths);
    const localizedTagFilters = JSON.parse(tagFilters);
    const uiLabels = JSON.parse(uiLabelsJson);

    const searchInput = document.getElementById('search-input');
    const searchButton = document.getElementById('search-button');
    const clearButton = document.getElementById('clear-button');
    const searchTags = document.getElementById('search-tags');
    const providerContainer = document.getElementById('provider-container');

    function escapeHtml(str) {
      if (str == null) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function padNumber(value) {
      return String(value).padStart(2, '0');
    }

    let currentSearch = '';
    let currentTagFilter = '';

    // Helper: parse tags JSON, supports old flat array and new bilingual format
    function parseTags(raw) {
      if (!raw) return [];
      try {
        const parsed = JSON.parse(raw);
        return parsed
          .map(tag => {
            if (typeof tag === 'string') return tag;
            return tag[lang] || tag.zh || tag.en || '';
          })
          .filter(Boolean);
      } catch {
        return [];
      }
    }

    // Stable keys for filter matching: always prefer the Chinese canonical
    // label so a filter works regardless of the current UI language.
    function canonicalTagKeys(raw) {
      if (!raw) return [];
      try {
        const parsed = JSON.parse(raw);
        return parsed
          .map(tag => typeof tag === 'string' ? tag : tag.zh || tag.en || '')
          .filter(Boolean);
      } catch {
        return [];
      }
    }

    // Helper: get all tag texts for search matching (both languages)
    function allTagTexts(raw) {
      if (!raw) return [];
      try {
        const parsed = JSON.parse(raw);
        return parsed.flatMap(tag => {
          if (typeof tag === 'string') return [tag];
          return [tag.zh, tag.en].filter(Boolean);
        });
      } catch {
        return [];
      }
    }

    searchButton.addEventListener('click', function(e) {
      e.preventDefault();
      currentSearch = searchInput.value.toLowerCase().trim();
      filterProviders();
    });

    searchInput.addEventListener('keypress', function(e) {
      if (e.key === 'Enter') {
        e.preventDefault();
        searchButton.click();
      }
    });

    function clearFilters() {
      searchInput.value = '';
      currentSearch = '';
      currentTagFilter = '';

      const tagButtons = searchTags.querySelectorAll('[data-tag]');
      tagButtons.forEach(button => {
        button.classList.remove('is-active');
        button.setAttribute('aria-pressed', 'false');
      });

      filterProviders();
      searchInput.focus();
    }

    clearButton.addEventListener('click', function(e) {
      e.preventDefault();
      clearFilters();
    });

    providerContainer.addEventListener('click', function(e) {
      if (e.target.closest('[data-clear-filters]')) {
        e.preventDefault();
        clearFilters();
      }
    });

    function filterProviders() {
      if (!currentSearch && !currentTagFilter) {
        renderProviders(allProviders);
        return;
      }

      const filtered = allProviders.filter(provider => {
        const content = provider.providers_content;
        const name = content?.name?.toLowerCase() || '';
        const desc = content?.desc?.toLowerCase() || '';
        const tagsForSearch = allTagTexts(provider.providers.tags);
        const tagKeys = canonicalTagKeys(provider.providers.tags);
        const filterKeys = localizedTagFilters[currentTagFilter] || [currentTagFilter];

        const matchesSearch = name.includes(currentSearch) ||
                            desc.includes(currentSearch) ||
                            tagsForSearch.some(tag => tag.toLowerCase().includes(currentSearch));

        const matchesTag = !currentTagFilter || filterKeys.some(key => tagKeys.includes(key));

        return matchesSearch && matchesTag;
      });

      renderProviders(filtered);
    }

    function renderProviders(providers) {
      const categories = new Map();
      for (const provider of providers) {
        const cat = provider.category;
        if (!categories.has(cat)) categories.set(cat, []);
        categories.get(cat).push(provider);
      }

      if (categories.size === 0) {
        providerContainer.innerHTML = `
          <div class="empty-state" role="status">
            <p class="empty-state-title">${escapeHtml(emptyLabel)}</p>
            <p class="empty-state-hint">${escapeHtml(emptyHintLabel)}</p>
            <button type="button" class="btn" data-clear-filters>${escapeHtml(clearFiltersLabel)}</button>
          </div>`;
        return;
      }

      const shouldLimit = !currentSearch && !currentTagFilter;
      providerContainer.innerHTML = Array.from(categories.entries()).map(([category, items]) => {
        const visibleItems = shouldLimit ? items.slice(0, categoryLimit) : items;
        const categoryLabel = localizedCategoryLabels[category] || category;
        const categoryPath = localizedCategoryPaths[category];
        const count = `${padNumber(visibleItems.length)} / ${padNumber(items.length)}`;
        return `
        <section class="section-gap">
          <div class="section-head">
            <h2 class="section-title">${escapeHtml(categoryLabel)}</h2>
            <div class="section-side">
              <span class="section-count">${count}</span>
              ${categoryPath ? `<a href="${escapeHtml(categoryPath)}" class="section-link">${escapeHtml(viewAllLabel)} →</a>` : ''}
            </div>
          </div>
          <div class="hair-grid">
            ${visibleItems.map(row => {
              const content = row.providers_content || { name: row.providers.slug_en, desc: null };
              const tags = parseTags(row.providers.tags);
              const rating = row.providers.rating != null && row.providers.rating > 0
                ? parseFloat(row.providers.rating).toFixed(1)
                : '—';
              const updated = row.providers.updated_at ? String(row.providers.updated_at).slice(0, 10) : '—';
              const slug = lang === 'zh' ? row.providers.slug_zh : row.providers.slug_en;
              const logoUrl = row.providers.logo_url;
              const logoInitial = (content.name || '·').trim().charAt(0).toUpperCase() || '·';

              return `
                <article class="card">
                  <div class="card-top">
                    ${logoUrl
                      ? `<img src="${escapeHtml(logoUrl)}" alt="" class="card-logo" loading="lazy" width="40" height="40" />`
                      : `<span class="card-logo card-logo-fallback" aria-hidden="true">${escapeHtml(logoInitial)}</span>`}
                    <div class="card-heading">
                      <span class="card-eyebrow">${escapeHtml(categoryLabel)}</span>
                      <h3 class="card-title">
                        <a href="/${lang}/provider/${escapeHtml(slug)}/" class="stretched-link">${escapeHtml(content.name)}</a>
                      </h3>
                    </div>
                  </div>
                  ${content.desc ? `<p class="card-desc">${escapeHtml(content.desc)}</p>` : ''}
                  ${tags.length > 0
                    ? `<div class="card-tags">${tags.map(tag => `<span class="chip">${escapeHtml(tag)}</span>`).join('')}</div>`
                    : ''}
                  <div class="card-metrics">
                    <span class="card-metric-value">${rating}${rating !== '—' ? '<span class="card-metric-scale"> / 5</span>' : ''}</span>
                    <span class="card-metric-label">${escapeHtml(uiLabels.editorial)}</span>
                  </div>
                  <div class="card-footer">
                    <span class="card-fact">${escapeHtml(uiLabels.updated)} ${updated}</span>
                    <span class="card-cta">
                      ${escapeHtml(uiLabels.viewDetails)}
                      <span class="card-arrow" aria-hidden="true">→</span>
                    </span>
                  </div>
                </article>
              `;
            }).join('')}
          </div>
        </section>
      `;
      }).join('');
    }

    if (searchTags) {
      searchTags.addEventListener('click', function(e) {
        const tagButton = e.target.closest('[data-tag]');
        if (tagButton) {
          const tag = tagButton.dataset.tag;
          currentTagFilter = currentTagFilter === tag ? '' : tag;
          searchTags.querySelectorAll('[data-tag]').forEach(btn => {
            btn.classList.remove('is-active');
            btn.setAttribute('aria-pressed', 'false');
          });
          if (currentTagFilter) {
            tagButton.classList.add('is-active');
            tagButton.setAttribute('aria-pressed', 'true');
          }
          filterProviders();
        }
      });
    }
  </script>
</BaseLayout>
