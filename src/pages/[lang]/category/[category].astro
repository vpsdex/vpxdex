---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProviderCard from '../../../components/ProviderCard.astro';
import Pagination from '../../../components/Pagination.astro';
import { providers, providersContent } from '../../../db/schema';
import { isValidLocale, locales, type Locale } from '../../../i18n/config';
import { t } from '../../../i18n/utils';
import { getDb } from '../../../lib/db';
import { isProviderCategory } from '../../../lib/provider-categories';
import { and, count, desc, eq } from 'drizzle-orm';
import { env } from 'cloudflare:workers';

const lang = Astro.params.lang as string;
const category = Astro.params.category as string;

if (!isValidLocale(lang) || !isProviderCategory(category)) {
  return new Response('Not Found', {
    status: 404,
    headers: { 'content-type': 'text/plain; charset=utf-8' },
  });
}

const locale = lang as Locale;
const categoryLabel = t(locale, `categories.${category}`);
const db = getDb(env.DB);
const pageSize = 12;
const pageParam = Astro.url.searchParams.get('page');
const currentPage = pageParam && /^\d+$/.test(pageParam) ? Number(pageParam) : 1;

if (currentPage < 1 || (pageParam !== null && (currentPage === 1 || !/^\d+$/.test(pageParam)))) {
  return Astro.redirect(`/${locale}/category/${category}/`, 301);
}

const whereClause = and(eq(providers.is_active, true), eq(providers.category, category));
const [{ total }] = await db
  .select({ total: count() })
  .from(providers)
  .innerJoin(
    providersContent,
    and(eq(providers.id, providersContent.provider_id), eq(providersContent.lang, locale)),
  )
  .where(whereClause);
const totalPages = Math.max(1, Math.ceil(total / pageSize));

if (currentPage > totalPages) {
  return Astro.redirect(
    `/${locale}/category/${category}/${totalPages > 1 ? `?page=${totalPages}` : ''}`,
    302,
  );
}

const rows = await db
  .select()
  .from(providers)
  .innerJoin(
    providersContent,
    and(eq(providers.id, providersContent.provider_id), eq(providersContent.lang, locale)),
  )
  .where(whereClause)
  .orderBy(desc(providers.id))
  .limit(pageSize)
  .offset((currentPage - 1) * pageSize);

const siteUrl = Astro.site!.href.replace(/\/$/, '');
const basePath = `/${locale}/category/${category}/`;
const pageSuffix = currentPage > 1 ? `?page=${currentPage}` : '';
const pageUrl = `${siteUrl}${basePath}${pageSuffix}`;
const alternates = locales.map((targetLocale) => ({
  lang: targetLocale,
  href: `${siteUrl}/${targetLocale}/category/${category}/${pageSuffix}`,
}));
const pageSuffixLabel = currentPage > 1
  ? t(locale, 'common.pageSuffix', { page: currentPage })
  : '';
const title = t(locale, 'category.seoTitle', {
  category: categoryLabel,
  page: pageSuffixLabel,
});
const description = t(locale, 'category.seoDescription', { category: categoryLabel });

const collectionJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description,
  url: pageUrl,
  inLanguage: locale,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: total,
    itemListElement: rows.map((row, index) => {
      const slug = locale === 'zh' ? row.providers.slug_zh : row.providers.slug_en;
      return {
        '@type': 'ListItem',
        position: (currentPage - 1) * pageSize + index + 1,
        url: `${siteUrl}/${locale}/provider/${slug}/`,
        name: row.providers_content.name,
      };
    }),
  },
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t(locale, 'nav.home'), item: `${siteUrl}/${locale}/` },
    { '@type': 'ListItem', position: 2, name: categoryLabel, item: pageUrl },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  lang={locale}
  alternates={alternates}
  xDefault={`${siteUrl}/zh/category/${category}/${pageSuffix}`}
  jsonLd={collectionJsonLd}
  extraJsonLd={[breadcrumbJsonLd]}
  canonical={pageUrl}
  prev={currentPage > 1 ? `${siteUrl}${basePath}${currentPage > 2 ? `?page=${currentPage - 1}` : ''}` : undefined}
  next={currentPage < totalPages ? `${siteUrl}${basePath}?page=${currentPage + 1}` : undefined}
>
  <nav class="breadcrumb" aria-label={t(locale, 'common.breadcrumb')}>
    <a href={`/${locale}/`}>{t(locale, 'nav.home')}</a>
    <span class="sep" aria-hidden="true">/</span>
    <span>{categoryLabel}</span>
  </nav>

  <section class="hero">
    <div class="hero-grid">
      <div>
        <p class="eyebrow">{t(locale, 'category.eyebrow')}</p>
        <h1 class="hero-title">{categoryLabel}</h1>
        <p class="hero-copy">{description}</p>
        <div class="hero-actions">
          <a class="btn" href={`/${locale}/activities/`}>
            {t(locale, 'category.latestActivities')}
          </a>
          <a class="text-link" href={`/${locale}/methodology/`}>
            {t(locale, 'common.method')} →
          </a>
        </div>
      </div>

      <div class="hero-facts" aria-label={t(locale, 'category.factsAria')}>
        <div class="fact-row">
          <span class="fact-label">{t(locale, 'category.listed')}</span>
          <span class="fact-value">{String(total).padStart(2, '0')}</span>
        </div>
        <div class="fact-row">
          <span class="fact-label">{t(locale, 'common.page')}</span>
          <span class="fact-value">{String(currentPage).padStart(2, '0')} / {String(totalPages).padStart(2, '0')}</span>
        </div>
        <div class="fact-row">
          <span class="fact-label">{t(locale, 'home.lastReviewed')}</span>
          <span class="fact-value">
            {rows.reduce((latest, row) => (row.providers.updated_at > latest ? row.providers.updated_at : latest), '').slice(0, 10) || '—'}
          </span>
        </div>
      </div>
    </div>
  </section>

  <section class="section-gap">
    <div class="section-head">
      <h2 class="section-title">
        {t(locale, 'category.allProviders', { category: categoryLabel })}
      </h2>
      <div class="section-side">
        <span class="section-count">{String(rows.length).padStart(2, '0')} / {String(total).padStart(2, '0')}</span>
      </div>
    </div>

    {rows.length > 0 ? (
      <div class="hair-grid">
        {rows.map((row) => (
          <ProviderCard
            provider={row.providers}
            content={row.providers_content}
            lang={locale}
          />
        ))}
      </div>
    ) : (
      <p class="empty-state">
        {t(locale, 'category.empty')}
      </p>
    )}
  </section>

  <Pagination
    currentPage={currentPage}
    totalPages={totalPages}
    basePath={basePath}
    lang={locale}
  />
</BaseLayout>
