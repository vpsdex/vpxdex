---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t } from '../../../i18n/utils';
import type { Locale } from '../../../i18n/config';
import { isValidLocale, locales, localeMeta } from '../../../i18n/config';
import { getDb } from '../../../lib/db';
import { activities, activitiesContent } from '../../../db/schema';
import { eq, and, desc, sql } from 'drizzle-orm';
import { env } from 'cloudflare:workers';
import { richTextToPlainText, sanitizeRichText } from '../../../lib/rich-text';
import { getActivityImageUrl } from '../../../lib/r2';
import { rankRelatedActivities } from '../../../lib/activity-related';

const lang = Astro.params.lang as string;
const slug = Astro.params.slug;

if (!isValidLocale(lang)) {
  return Astro.redirect('/zh/');
}
if (!slug) {
  return new Response('Not Found', { status: 404 });
}

const db = getDb(env.DB);

const getActivityByLocalizedSlug = (activitySlug: string) =>
  db
    .select({
      id: activities.id,
      baseSlug: activities.slug,
      publishedAt: activities.published_at,
      isFeatured: activities.is_featured,
      featuredImageKey: activities.featured_image_key,
      viewCount: activities.view_count,
      contentSlug: activitiesContent.slug,
      title: activitiesContent.title,
      description: activitiesContent.description,
      content: activitiesContent.content,
      metaTitle: activitiesContent.meta_title,
      metaDesc: activitiesContent.meta_desc,
    })
    .from(activities)
    .innerJoin(
      activitiesContent,
      and(eq(activitiesContent.activity_id, activities.id), eq(activitiesContent.lang, lang)),
    )
    .where(and(eq(activitiesContent.slug, activitySlug), eq(activities.is_active, true)))
    .limit(1);

const getActivityByBaseSlug = (activitySlug: string) =>
  db
    .select({
      id: activities.id,
      baseSlug: activities.slug,
      publishedAt: activities.published_at,
      isFeatured: activities.is_featured,
      featuredImageKey: activities.featured_image_key,
      viewCount: activities.view_count,
      contentSlug: activitiesContent.slug,
      title: activitiesContent.title,
      description: activitiesContent.description,
      content: activitiesContent.content,
      metaTitle: activitiesContent.meta_title,
      metaDesc: activitiesContent.meta_desc,
    })
  .from(activities)
    .innerJoin(
      activitiesContent,
      and(eq(activitiesContent.activity_id, activities.id), eq(activitiesContent.lang, lang)),
    )
    .where(and(eq(activities.slug, activitySlug), eq(activities.is_active, true)))
    .limit(1);

let activityData = await getActivityByLocalizedSlug(slug);
if (!activityData[0]) {
  activityData = await getActivityByBaseSlug(slug);
}

const activityBasic = activityData[0];

if (!activityBasic) {
  return new Response('Not Found', {
    status: 404,
    headers: { 'content-type': 'text/plain; charset=utf-8' },
  });
}

const activity = {
  id: activityBasic.id,
  slug: activityBasic.contentSlug || activityBasic.baseSlug,
  publishedAt: activityBasic.publishedAt,
  isFeatured: activityBasic.isFeatured,
  featuredImage: getActivityImageUrl(activityBasic.featuredImageKey),
  viewCount: activityBasic.viewCount,
  title: activityBasic.title || '',
  description: activityBasic.description || '',
  content: activityBasic.content || '',
  metaTitle: activityBasic.metaTitle || '',
  metaDesc: activityBasic.metaDesc || '',
};

if (slug !== activity.slug) {
  return Astro.redirect(`/${lang}/activity/${activity.slug}/`, 301);
}

// Only count real page views: skip crawlers and browser prefetches so bots
// cannot burn through the free-tier D1 write budget.
const userAgent = Astro.request.headers.get('user-agent') || '';
const isPrefetch = (Astro.request.headers.get('purpose') || '').includes('prefetch');
const isBot = /bot|crawler|spider|slurp|bingpreview|facebookexternalhit|headless|lighthouse/i.test(userAgent);
const shouldTrackView = !isPrefetch && !isBot;
if (shouldTrackView) {
  await db.update(activities)
    .set({ view_count: sql`${activities.view_count} + 1` })
    .where(eq(activities.id, activityBasic.id));
}
const displayViewCount = activity.viewCount + (shouldTrackView ? 1 : 0);

// Rank related activities by shared provider/topic terms, then use recency only as fallback.
const relatedRows = await db
  .select({
    id: activities.id,
    slug: activitiesContent.slug,
    fallbackSlug: activities.slug,
    title: activitiesContent.title,
    publishedAt: activities.published_at,
  })
  .from(activities)
  .innerJoin(
    activitiesContent,
    and(eq(activitiesContent.activity_id, activities.id), eq(activitiesContent.lang, lang)),
  )
  .where(and(
    eq(activities.is_active, true),
    sql`${activities.id} != ${activityBasic.id}`
  ))
  .orderBy(desc(activities.published_at))
  .limit(200);

const relatedActivities = rankRelatedActivities(
  relatedRows.map((row) => ({
    id: row.id,
    slug: row.slug || row.fallbackSlug,
    title: row.title || '',
    publishedAt: row.publishedAt,
  })),
  { id: activityBasic.id, slug: activity.slug, title: activity.title },
  4,
);

const localizedSlugRows = await db
  .select({ lang: activitiesContent.lang, slug: activitiesContent.slug })
  .from(activitiesContent)
  .where(eq(activitiesContent.activity_id, activityBasic.id));
const localizedSlugs = new Map(localizedSlugRows.map((row) => [row.lang, row.slug]));

const siteName = t(lang, 'site.brand');
const pageTitle = activity.metaTitle || activity.title;
const pageDesc = activity.metaDesc || activity.description || richTextToPlainText(activity.content).slice(0, 160);
const siteUrl = Astro.site!.href.replace(/\/$/, '');
const pageUrl = `${siteUrl}/${lang}/activity/${activity.slug}/`;
const featuredImageUrl = activity.featuredImage ? `${siteUrl}${activity.featuredImage}` : null;
const availableLocales = locales.filter((locale) => localizedSlugs.has(locale));
const xDefaultLocale = availableLocales.includes('zh') ? 'zh' : availableLocales[0];
const alternates = availableLocales.map((locale) => ({
  lang: locale,
  href: `${siteUrl}/${locale}/activity/${localizedSlugs.get(locale)}/`,
}));
const xDefaultUrl = `${siteUrl}/${xDefaultLocale}/activity/${localizedSlugs.get(xDefaultLocale)}/`;

// Get content as plain text for SEO
const contentText = richTextToPlainText(activity.content);
const wordCount = lang === 'zh'
  ? contentText.replace(/\s+/g, '').length
  : contentText.split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.ceil(lang === 'zh' ? wordCount / 400 : wordCount / 200));

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: activity.title,
  description: pageDesc,
  url: pageUrl,
  datePublished: activity.publishedAt,
  dateModified: activity.publishedAt,
  inLanguage: lang,
  wordCount,
  ...(featuredImageUrl && { image: featuredImageUrl }),
  author: {
    '@type': 'Organization',
    name: siteName,
  },
  publisher: {
    '@type': 'Organization',
    name: siteName,
    logo: {
      '@type': 'ImageObject',
      url: `${siteUrl}/logo.png`,
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': pageUrl,
  },
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: t(lang, 'nav.home'),
      item: `${siteUrl}/${lang}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: t(lang, 'common.latestActivities'),
      item: `${siteUrl}/${lang}/activities/`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: activity.title,
      item: pageUrl,
    },
  ],
};

const fullTitle = `${pageTitle} - ${siteName}`;
---

<BaseLayout
  title={fullTitle}
  description={pageDesc}
  lang={lang as Locale}
  alternates={alternates}
  jsonLd={articleJsonLd}
  extraJsonLd={[breadcrumbJsonLd]}
  xDefault={xDefaultUrl}
  canonical={pageUrl}
  image={featuredImageUrl || undefined}
  ogType="article"
  twitterCard={featuredImageUrl ? 'summary_large_image' : 'summary'}
  publishedTime={activity.publishedAt}
>
  <nav class="breadcrumb" aria-label={t(lang, 'common.breadcrumb')}>
    <a href={`/${lang}/`}>{t(lang, 'nav.home')}</a>
    <span class="sep" aria-hidden="true">/</span>
    <a href={`/${lang}/activities/`}>{t(lang, 'common.latestActivities')}</a>
    <span class="sep" aria-hidden="true">/</span>
    <span>{activity.title}</span>
  </nav>

  <div class="detail-grid">
    <div class="detail-main">
      <header class="article-head">
        <p class="eyebrow is-plain">
          {activity.isFeatured && <>{t(lang, 'common.featured')} · </>}
          {activity.publishedAt.slice(0, 10)}
        </p>
        <h1 class="article-title">{activity.title}</h1>

        {activity.description && <p class="article-desc">{activity.description}</p>}

        <div class="article-meta">
          <time datetime={activity.publishedAt}>{activity.publishedAt.slice(0, 10)}</time>
          <span class="sep" aria-hidden="true">·</span>
          <span>{t(lang, 'common.minRead', { count: readingTime })}</span>
          <span class="sep" aria-hidden="true">·</span>
          <span>{t(lang, 'common.viewCount', { count: displayViewCount })}</span>
        </div>

        <div class="mobile-facts">
          <div class="mobile-fact">
            <span class="mobile-fact-label">{t(lang, 'common.published')}</span>
            <span class="mobile-fact-value">{activity.publishedAt.slice(0, 10)}</span>
          </div>
          <div class="mobile-fact">
            <span class="mobile-fact-label">{t(lang, 'common.read')}</span>
            <span class="mobile-fact-value">{readingTime} {t(lang, 'common.minutes')}</span>
          </div>
          <div class="mobile-fact">
            <span class="mobile-fact-label">{t(lang, 'common.views')}</span>
            <span class="mobile-fact-value">{displayViewCount}</span>
          </div>
        </div>
      </header>

      {activity.featuredImage && (
        <figure class="article-media">
          <img
            src={activity.featuredImage}
            alt={activity.title}
            width="960"
            height="540"
            fetchpriority="high"
          />
        </figure>
      )}

      <div class="article-body rich-content">
        <div set:html={sanitizeRichText(activity.content) || '<p>' + richTextToPlainText(activity.content) + '</p>'} />
      </div>

      {relatedActivities.length > 0 && (
        <section class="provider-section" aria-labelledby="related-activities-heading">
          <h2 id="related-activities-heading" class="side-heading">
            {t(lang, 'activity.related')}
          </h2>
          <ul class="related-list">
            {relatedActivities.map((related) => (
              <li>
                <a href={`/${lang}/activity/${related.slug}/`}>
                  <span>{related.title}</span>
                  <time datetime={related.publishedAt}>{related.publishedAt.slice(0, 10)}</time>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>

    <aside class="detail-aside" aria-label={t(lang, 'activity.factsAria')}>
      <div class="detail-aside-inner">
        <div class="side-block">
          <h2 class="side-heading">{t(lang, 'common.record')}</h2>
          <dl class="kv">
            <dt>{t(lang, 'common.published')}</dt>
            <dd>{activity.publishedAt.slice(0, 10)}</dd>
            <dt>{t(lang, 'common.read')}</dt>
            <dd>{readingTime} {t(lang, 'common.minutes')}</dd>
            <dt>{t(lang, 'common.views')}</dt>
            <dd>{displayViewCount}</dd>
            <dt>{t(lang, 'common.language')}</dt>
            <dd>{localeMeta[lang].languageName}</dd>
          </dl>
        </div>
      </div>
    </aside>
  </div>
</BaseLayout>
