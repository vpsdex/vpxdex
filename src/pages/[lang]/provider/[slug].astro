---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { locales, type Locale, isValidLocale } from '../../../i18n/config';
import { t, getProviderAlternateUrl } from '../../../i18n/utils';
import { getLogoUrl } from '../../../lib/r2';
import { getDb } from '../../../lib/db';
import { providers, providersContent, activities, activitiesContent } from '../../../db/schema';
import { eq, and, desc as descOrder, like, or } from 'drizzle-orm';
import { env } from 'cloudflare:workers';
import { sanitizeRichText, richTextToPlainText } from '../../../lib/rich-text';
import { parseStoredTags } from '../../../lib/validation';
import { rankRelatedActivities } from '../../../lib/activity-related';

const lang = Astro.params.lang as string;
if (!isValidLocale(lang)) {
  return Astro.redirect('/zh/');
}

const slug = Astro.params.slug as string;
const db = getDb(env.DB);

// Find provider by slug
const field = lang === 'zh' ? 'slug_zh' : 'slug_en';
const provider = await db
  .select()
 .from(providers)
  .where(and(eq(providers[field], slug), eq(providers.is_active, true)))
  .get();

if (!provider) {
  return new Response('Not Found', {
    status: 404,
    headers: { 'content-type': 'text/plain; charset=utf-8' },
  });
}

// Load every translation so hreflang only points at pages that exist.
const contentRows = await db
  .select()
  .from(providersContent)
  .where(eq(providersContent.provider_id, provider.id));
const contentByLang = new Map(contentRows.map((row) => [row.lang, row]));
const content = contentByLang.get(lang);

if (!content) {
  return new Response('Not Found', {
    status: 404,
    headers: { 'content-type': 'text/plain; charset=utf-8' },
  });
}

const name = content.name;
const desc = content?.desc;
const descText = richTextToPlainText(desc);
const categoryLabel = t(lang as Locale, `categories.${provider.category}`);
const metaTitle = content?.meta_title || `${name} - ${t(lang as Locale, 'site.brand')}`;
// 始终保证 meta description 有内容：DB > 正文摘要 > 通用兜底文案
const metaDesc = content.meta_desc
  || descText
  || t(lang, 'provider.metaFallback', {
    name,
    category: categoryLabel,
    brand: t(lang, 'site.brand'),
  });
const logoUrl = getLogoUrl(provider.logo_key, provider.updated_at);
const logoInitial = name.trim().charAt(0).toUpperCase() || '·';

const providerSlug = lang === 'zh' ? provider.slug_zh : provider.slug_en;
// Filter in SQL so we never load the entire activity table for one provider.
const activityRows = await db
  .select({
    id: activities.id,
    slug: activitiesContent.slug,
    title: activitiesContent.title,
    publishedAt: activities.published_at,
  })
  .from(activities)
  .innerJoin(
    activitiesContent,
    and(eq(activitiesContent.activity_id, activities.id), eq(activitiesContent.lang, lang)),
  )
  .where(and(
    eq(activities.is_active, true),
    or(
      like(activities.slug, `%${providerSlug}%`),
      like(activitiesContent.slug, `%${providerSlug}%`),
      like(activitiesContent.title, `%${name}%`),
    ),
  ))
  .orderBy(descOrder(activities.published_at))
  .limit(50);
const providerActivities = rankRelatedActivities(
  activityRows.map((row) => ({
    id: row.id,
    slug: row.slug,
    title: row.title,
    publishedAt: row.publishedAt,
  })),
  { slug: providerSlug, title: name },
  3,
);

const siteUrl = Astro.site!.href.replace(/\/$/, '');
const availableLocales = locales.filter((locale) => contentByLang.has(locale));
const xDefaultLocale = availableLocales.includes('zh') ? 'zh' : availableLocales[0];
const alternates = availableLocales.map((locale) => ({
  lang: locale,
  href: `${siteUrl}${getProviderAlternateUrl(locale, provider.slug_zh, provider.slug_en)}`,
}));

// Parse tags JSON (supports both old flat array and new bilingual format)
const rawTags = parseStoredTags(provider.tags);
const tags = rawTags
  .map(tag => {
    if (typeof tag === 'string') return tag;
    return tag[lang] || tag.zh || tag.en || '';
  })
  .filter(Boolean);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name,
  url: provider.url,
  description: descText || undefined,
  aggregateRating: provider.rating
    ? {
        '@type': 'AggregateRating',
        ratingValue: provider.rating,
        bestRating: 5,
        worstRating: 1,
        ratingCount: 1,
      }
    : undefined,
};

const categoryTagText = tags.length > 0
  ? tags.slice(0, 6).join(lang === 'zh' ? '、' : ', ')
  : '';
const ratingText = provider.rating != null && provider.rating > 0 ? provider.rating.toFixed(1) : null;
const ratingPhrase = ratingText ? t(lang, 'provider.ratingPhrase', { rating: ratingText }) : '';
const tagPhrase = categoryTagText ? t(lang, 'provider.tagPhrase', { tags: categoryTagText }) : '';
const suitableTagPhrase = categoryTagText
  ? t(lang, 'provider.suitableTagPhrase', { tags: categoryTagText })
  : '';
const faqItems = [
  {
    q: t(lang, 'provider.qHow', { name }),
    a: t(lang, 'provider.aHow', {
      name,
      category: categoryLabel,
      rating: ratingPhrase,
      tags: tagPhrase,
    }),
  },
  {
    q: t(lang, 'provider.qSuitable', { name }),
    a: t(lang, 'provider.aSuitable', {
      name,
      category: categoryLabel,
      tags: suitableTagPhrase,
    }),
  },
  {
    q: t(lang, 'provider.qVisit', { name }),
    a: t(lang, 'provider.aVisit', { name }),
  },
];
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<BaseLayout
  title={metaTitle}
  description={metaDesc}
  lang={lang}
  alternates={alternates}
  jsonLd={jsonLd}
  extraJsonLd={[faqJsonLd]}
  xDefault={`${siteUrl}${getProviderAlternateUrl(xDefaultLocale, provider.slug_zh, provider.slug_en)}`}
>
  <nav class="breadcrumb" aria-label={t(lang, 'common.breadcrumb')}>
    <a href={`/${lang}/`}>{t(lang, 'nav.home')}</a>
    <span class="sep" aria-hidden="true">/</span>
    <a href={`/${lang}/category/${provider.category}/`}>{categoryLabel}</a>
    <span class="sep" aria-hidden="true">/</span>
    <span>{name}</span>
  </nav>

  <div class="detail-grid">
    <div class="detail-main">
      <header class="provider-head">
        {provider.logo_key ? (
          <img
            src={logoUrl}
            alt=""
            class="provider-logo"
            width="64"
            height="64"
          />
        ) : (
          <div class="provider-logo provider-logo-fallback" aria-hidden="true">{logoInitial}</div>
        )}
        <div class="provider-head-body">
          <p class="eyebrow is-plain">{categoryLabel}</p>
          <h1 class="provider-name">{name}</h1>

          {provider.rating != null && provider.rating > 0 && (
            <div class="provider-rating">
              <strong>{provider.rating.toFixed(1)}</strong>
              <span>/ 5 · {t(lang, 'provider.editorialComposite')}</span>
            </div>
          )}
          <p class="provider-note">
            {t(lang, 'provider.ratingNote')}
          </p>

          {tags.length > 0 && (
            <div class="provider-tags">
              {tags.map((tag) => <span class="chip">{tag}</span>)}
            </div>
          )}

          <div class="provider-actions">
            <a
              href={provider.url}
              target="_blank"
              rel="noopener noreferrer"
              class="btn"
            >
              {t(lang, 'provider.visit')} →
            </a>
            <a class="text-link" href={`/${lang}/methodology/`}>
              {t(lang, 'provider.howRatingsWork')}
            </a>
          </div>

          <div class="mobile-facts">
            <div class="mobile-fact">
              <span class="mobile-fact-label">{t(lang, 'common.category')}</span>
              <span class="mobile-fact-value">{categoryLabel}</span>
            </div>
            <div class="mobile-fact">
              <span class="mobile-fact-label">{t(lang, 'common.rating')}</span>
              <span class="mobile-fact-value">{ratingText || '—'} / 5</span>
            </div>
            <div class="mobile-fact">
              <span class="mobile-fact-label">{t(lang, 'common.updated')}</span>
              <span class="mobile-fact-value">{provider.updated_at.slice(0, 10)}</span>
            </div>
          </div>
        </div>
      </header>

      {desc && (
        <section class="provider-section" aria-labelledby="provider-description">
          <h2 id="provider-description" class="side-heading">{t(lang, 'provider.description')}</h2>
          <div class="rich-content" set:html={sanitizeRichText(desc) || ''} />
        </section>
      )}

      {providerActivities.length > 0 && (
        <section class="provider-section" aria-labelledby="provider-reviews-heading">
          <h2 id="provider-reviews-heading" class="side-heading">
            {t(lang, 'provider.reviewsHeading', { name })}
          </h2>
          <ul class="related-list">
            {providerActivities.map((activity) => (
              <li>
                <a href={`/${lang}/activity/${activity.slug}/`}>
                  <span>{activity.title}</span>
                  <time datetime={activity.publishedAt}>{activity.publishedAt.slice(0, 10)}</time>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <section class="provider-section">
        <p class="side-note">
          {t(lang, 'provider.infoNote')}
        </p>
        <p class="side-note">
          <a href={`/${lang}/methodology/`}>{t(lang, 'provider.methodology')}</a>
          <span aria-hidden="true"> · </span>
          <a href={`/${lang}/disclosure/`}>{t(lang, 'provider.disclosure')}</a>
        </p>
      </section>

      <section class="provider-section" aria-labelledby="provider-faq">
        <h2 id="provider-faq" class="side-heading">
          {t(lang, 'provider.faqHeading')}
        </h2>
        <div>
          {faqItems.map((item) => (
            <div class="faq-item">
              <h3>{item.q}</h3>
              <p>{item.a}</p>
            </div>
          ))}
        </div>
      </section>
    </div>

    <aside class="detail-aside" aria-label={t(lang, 'provider.factsAria')}>
      <div class="detail-aside-inner">
        <div class="side-block">
          <h2 class="side-heading">{t(lang, 'common.record')}</h2>
          <dl class="kv">
            <dt>{t(lang, 'common.category')}</dt>
            <dd>{categoryLabel}</dd>
            <dt>{t(lang, 'common.rating')}</dt>
            <dd>{ratingText ? `${ratingText} / 5` : '—'}</dd>
            <dt>{t(lang, 'common.updated')}</dt>
            <dd>{provider.updated_at.slice(0, 10)}</dd>
            <dt>{t(lang, 'provider.website')}</dt>
            <dd>
              <a href={provider.url} target="_blank" rel="noopener noreferrer">
                {t(lang, 'provider.visit')} →
              </a>
            </dd>
          </dl>
        </div>
      </div>
    </aside>
  </div>
</BaseLayout>
