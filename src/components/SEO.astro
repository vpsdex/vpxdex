---
import { defaultLocale, isValidLocale, localeMeta } from '../i18n/config';

interface Props {
  title: string;
  description?: string;
  lang?: string;
  alternates?: { lang: string; href: string }[];
  jsonLd?: Record<string, unknown>;
  xDefault?: string;
  canonical?: string;
  prev?: string;
  next?: string;
  image?: string;
  ogType?: 'website' | 'article';
  twitterCard?: 'summary' | 'summary_large_image';
  publishedTime?: string;
}

const {
  title, description, lang = 'zh', alternates, jsonLd, xDefault, canonical, prev, next,
  image, ogType = 'website', twitterCard = 'summary', publishedTime,
} = Astro.props;
const siteUrl = Astro.site!.href.replace(/\/$/, '');
const canonicalUrl = canonical || `${siteUrl}${Astro.url.pathname}`;
const siteName = 'VPSDEX';
const ogImage = image
  ? (image.startsWith('http') ? image : `${siteUrl}${image}`)
  : `${siteUrl}/og-image.png`;
const currentLocale = isValidLocale(lang) ? lang : defaultLocale;
const ogLocale = localeMeta[currentLocale].ogLocale;
const alternateOgLocales: string[] = [];
for (const alt of alternates ?? []) {
  if (alt.lang !== currentLocale && isValidLocale(alt.lang)) {
    alternateOgLocales.push(localeMeta[alt.lang].ogLocale);
  }
}
const uniqueAlternateOgLocales = [...new Set(alternateOgLocales)];
const resolvedXDefault = xDefault
  || alternates?.find((alt) => alt.lang === 'zh')?.href
  || alternates?.[0]?.href
  || canonicalUrl;
---

<title>{title}</title>
<meta name="description" content={description || ''} />
<link rel="canonical" href={canonicalUrl} />
{prev && <link rel="prev" href={prev} />}
{next && <link rel="next" href={next} />}
<meta name="generator" content={Astro.generator} />

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description || ''} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content={ogLocale} />
{uniqueAlternateOgLocales.map((alternateLocale) => (
  <meta property="og:locale:alternate" content={alternateLocale} />
))}
{publishedTime && <meta property="article:published_time" content={publishedTime} />}

<!-- Twitter Card -->
<meta name="twitter:card" content={twitterCard} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description || ''} />
<meta name="twitter:image" content={ogImage} />

<!-- Hreflang -->
{alternates?.map((alt) => <link rel="alternate" hreflang={alt.lang} href={alt.href} />)}
<link rel="alternate" hreflang="x-default" href={resolvedXDefault} />

{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
