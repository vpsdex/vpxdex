---
import type { Locale } from '../i18n/config';
import { t } from '../i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';
import BrandMark from './BrandMark.astro';
import { primaryProviderCategories } from '../lib/provider-categories';

interface Props {
  lang: Locale;
  alternates?: { lang: string; href: string }[];
}

const { lang, alternates } = Astro.props;
const currentPath = Astro.url.pathname;
const menuLabel = t(lang, 'header.menuOpen');
const closeLabel = t(lang, 'header.menuClose');
---

<header class="site-header">
  <div class="container header-inner">
    <a href={`/${lang}/`} class="brand" aria-label={t(lang, 'site.brand')}>
      <BrandMark />
      <span>{t(lang, 'site.brand')}</span>
    </a>

    <nav class="nav-links" aria-label={t(lang, 'nav.primary')}>
      <a href={`/${lang}/`} aria-current={currentPath === `/${lang}/` ? 'page' : undefined} class:list={["nav-link", { "is-active": currentPath === `/${lang}/` }]}>
        {t(lang, 'nav.home')}
      </a>
      {primaryProviderCategories.map((category) => {
        const href = `/${lang}/category/${category}/`;
        return (
          <a
            href={href}
            aria-current={currentPath === href ? 'page' : undefined}
            class:list={["nav-link", { "is-active": currentPath === href }]}
          >
            {t(lang, `categories.${category}`)}
          </a>
        );
      })}
      <a href={`/${lang}/activities/`} aria-current={currentPath.startsWith(`/${lang}/activit`) ? 'page' : undefined} class:list={["nav-link", { "is-active": currentPath.startsWith(`/${lang}/activit`) }]}>
        {t(lang, 'nav.activities')}
      </a>
      <LanguageSwitcher lang={lang} alternates={alternates} />
    </nav>

    <div class="mobile-actions">
      <LanguageSwitcher lang={lang} alternates={alternates} />
      <button
        type="button"
        class="mobile-menu-toggle"
        aria-label={menuLabel}
        aria-controls="mobile-site-menu"
        aria-expanded="false"
        data-mobile-menu-toggle
      >
        <span class="sr-only">{menuLabel}</span>
        <span aria-hidden="true" class="mobile-menu-toggle-lines">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </button>
    </div>
  </div>
</header>

<button
  type="button"
  class="mobile-menu-backdrop"
  aria-label={closeLabel}
  tabindex="-1"
  data-mobile-menu-backdrop
></button>

<aside
  id="mobile-site-menu"
  class="mobile-menu-drawer"
  aria-hidden="true"
  aria-label={t(lang, 'nav.mobile')}
  inert
  data-mobile-menu-drawer
>
  <div class="mobile-menu-header">
    <div>
      <p class="mobile-menu-eyebrow">{t(lang, 'nav.navigation')}</p>
      <p class="mobile-menu-title">{t(lang, 'site.brand')}</p>
    </div>
    <button
      type="button"
      class="mobile-menu-close"
      aria-label={closeLabel}
      data-mobile-menu-close
    >
      <span aria-hidden="true">&times;</span>
    </button>
  </div>

  <div class="mobile-menu-links">
    <a href={`/${lang}/`} aria-current={currentPath === `/${lang}/` ? 'page' : undefined} class:list={["mobile-nav-link", { "is-active": currentPath === `/${lang}/` }]}>
      {t(lang, 'nav.home')}
    </a>
    {primaryProviderCategories.map((category) => {
      const href = `/${lang}/category/${category}/`;
      return (
        <a
          href={href}
          aria-current={currentPath === href ? 'page' : undefined}
          class:list={["mobile-nav-link", { "is-active": currentPath === href }]}
        >
          {t(lang, `categories.${category}`)}
        </a>
      );
    })}
    <a href={`/${lang}/activities/`} aria-current={currentPath.startsWith(`/${lang}/activit`) ? 'page' : undefined} class:list={["mobile-nav-link", { "is-active": currentPath.startsWith(`/${lang}/activit`) }]}>
      {t(lang, 'nav.activities')}
    </a>
  </div>

  <p class="mobile-menu-note">
    {t(lang, 'header.note')}
  </p>
</aside>

<script>
  const menuToggle = document.querySelector<HTMLButtonElement>('[data-mobile-menu-toggle]');
  const menuDrawer = document.querySelector<HTMLElement>('[data-mobile-menu-drawer]');
  const menuBackdrop = document.querySelector<HTMLButtonElement>('[data-mobile-menu-backdrop]');
  const menuClose = document.querySelector<HTMLButtonElement>('[data-mobile-menu-close]');
  let previouslyFocused: HTMLElement | null = null;

  const setMenuOpen = (open: boolean) => {
    if (!menuToggle || !menuDrawer || !menuBackdrop) return;

    menuToggle.setAttribute('aria-expanded', String(open));
    menuDrawer.setAttribute('aria-hidden', String(!open));
    menuDrawer.inert = !open;
    menuDrawer.classList.toggle('is-open', open);
    menuBackdrop.classList.toggle('is-open', open);
    document.body.classList.toggle('mobile-menu-open', open);

    if (open) {
      previouslyFocused = document.activeElement instanceof HTMLElement ? document.activeElement : menuToggle;
      menuClose?.focus();
    } else {
      previouslyFocused?.focus();
      previouslyFocused = null;
    }
  };

  menuToggle?.addEventListener('click', () => setMenuOpen(true));
  menuBackdrop?.addEventListener('click', () => setMenuOpen(false));
  menuClose?.addEventListener('click', () => setMenuOpen(false));
  menuDrawer?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenuOpen(false)));

  document.addEventListener('keydown', (event) => {
    if (menuDrawer?.getAttribute('aria-hidden') !== 'false') return;

    if (event.key === 'Escape') {
      event.preventDefault();
      setMenuOpen(false);
      return;
    }

    if (event.key !== 'Tab') return;
    const focusable = Array.from(menuDrawer.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'));
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (!first || !last) return;

    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });

  window.matchMedia('(min-width: 960px)').addEventListener('change', (event) => {
    if (event.matches && menuDrawer?.getAttribute('aria-hidden') === 'false') setMenuOpen(false);
  });
</script>
