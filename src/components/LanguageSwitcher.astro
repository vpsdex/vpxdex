---
import { locales, localeMeta, type Locale } from '../i18n/config';
import { getAlternateUrl, t } from '../i18n/utils';

interface Props {
  lang: Locale;
  alternates?: { lang: string; href: string }[];
}

const { lang, alternates } = Astro.props;
const alternateMap = new Map(alternates?.map((item) => [item.lang, item.href]) || []);
// When a page reports its real translations, hide languages that do not exist
// instead of linking to a 404.
const availableLocales = alternates
  ? locales.filter((locale) => alternateMap.has(locale))
  : locales;
---

<div class="lang-switch" role="group" aria-label={t(lang, 'common.language')}>
  {availableLocales.map((locale) => (
    <a
      href={alternateMap.get(locale) || getAlternateUrl(Astro.url, locale)}
      class:list={['lang-link', locale === lang && 'is-current']}
      hreflang={locale}
      aria-label={localeMeta[locale].switchLabel}
      aria-current={locale === lang ? 'true' : undefined}
    >
      {localeMeta[locale].label}
    </a>
  ))}
</div>
