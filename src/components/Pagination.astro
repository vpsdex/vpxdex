---
import { t } from '../i18n/utils';

interface Props {
  currentPage: number;
  totalPages: number;
  basePath: string;
  query?: Record<string, string | undefined>;
  lang: 'zh' | 'en';
}

const { currentPage, totalPages, basePath, query = {}, lang } = Astro.props;

const pageHref = (page: number) => {
  const params = new URLSearchParams();
  for (const [key, value] of Object.entries(query)) {
    if (value) params.set(key, value);
  }
  if (page > 1) params.set('page', String(page));
  const search = params.toString();
  return `${basePath}${search ? `?${search}` : ''}`;
};

const pageNumbers = Array.from({ length: totalPages }, (_, index) => index + 1).filter((page) => (
  page === 1 || page === totalPages || Math.abs(page - currentPage) <= 2
));
const formatPage = (page: number) => String(page).padStart(2, '0');
---

{totalPages > 1 && (
  <nav class="pagination" aria-label={t(lang, 'pagination.aria')}>
    {currentPage > 1 ? (
      <a class="pagination-link" href={pageHref(currentPage - 1)} rel="prev">
        {t(lang, 'pagination.previous')}
      </a>
    ) : (
      <span class="pagination-link is-disabled" aria-disabled="true">{t(lang, 'pagination.previous')}</span>
    )}

    {pageNumbers.map((page, index) => (
      <Fragment>
        {index > 0 && page - pageNumbers[index - 1] > 1 && <span class="pagination-gap" aria-hidden="true">…</span>}
        <a
          class:list={['pagination-link', { 'is-current': page === currentPage }]}
          href={pageHref(page)}
          aria-current={page === currentPage ? 'page' : undefined}
        >
          {formatPage(page)}
        </a>
      </Fragment>
    ))}

    {currentPage < totalPages ? (
      <a class="pagination-link" href={pageHref(currentPage + 1)} rel="next">
        {t(lang, 'pagination.next')}
      </a>
    ) : (
      <span class="pagination-link is-disabled" aria-disabled="true">{t(lang, 'pagination.next')}</span>
    )}
  </nav>
)}
