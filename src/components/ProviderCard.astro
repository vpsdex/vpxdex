---
import type { Locale } from '../i18n/config';
import { t } from '../i18n/utils';
import { getLogoUrl } from '../lib/r2';
import { richTextToPlainText } from '../lib/rich-text';
import { parseStoredTags } from '../lib/validation';

interface Props {
  provider: {
    slug_zh: string;
    slug_en: string;
    category: string;
    rating: number | null;
    logo_key: string | null;
    tags: string | null;
    updated_at: string;
  };
  content: {
    name: string;
    desc: string | null;
  };
  lang: Locale;
}

const { provider, content, lang } = Astro.props;
const slug = lang === 'zh' ? provider.slug_zh : provider.slug_en;
const descText = richTextToPlainText(content.desc);

const rawTags = parseStoredTags(provider.tags);
const tags = rawTags
  .map((tag) => {
    if (typeof tag === 'string') return tag;
    return tag[lang] || tag.zh || tag.en || '';
  })
  .filter(Boolean);

const ratingText = provider.rating != null && provider.rating > 0 ? provider.rating.toFixed(1) : '—';
const updated = provider.updated_at.slice(0, 10);
const categoryLabel = t(lang, `categories.${provider.category}`);
const logoUrl = provider.logo_key ? getLogoUrl(provider.logo_key, provider.updated_at) : null;
const logoInitial = content.name.trim().charAt(0).toUpperCase() || '·';
---

<article class="card">
  <div class="card-top">
    {logoUrl ? (
      <img
        src={logoUrl}
        alt=""
        class="card-logo"
        loading="lazy"
        width="40"
        height="40"
      />
    ) : (
      <span class="card-logo card-logo-fallback" aria-hidden="true">{logoInitial}</span>
    )}
    <div class="card-heading">
      <span class="card-eyebrow">{categoryLabel}</span>
      <h3 class="card-title">
        <a href={`/${lang}/provider/${slug}/`} class="stretched-link">{content.name}</a>
      </h3>
    </div>
  </div>

  {descText && <p class="card-desc">{descText}</p>}

  {tags.length > 0 && (
    <div class="card-tags">
      {tags.map((tag) => <span class="chip">{tag}</span>)}
    </div>
  )}

  <div class="card-metrics">
    <span class="card-metric-value">
      {ratingText}{ratingText !== '—' && <span class="card-metric-scale"> / 5</span>}
    </span>
    <span class="card-metric-label">{t(lang, 'home.editorial')}</span>
  </div>

  <div class="card-footer">
    <span class="card-fact">{t(lang, 'common.updated')} {updated}</span>
    <span class="card-cta">
      {t(lang, 'home.viewDetails')}
      <span class="card-arrow" aria-hidden="true">→</span>
    </span>
  </div>
</article>
