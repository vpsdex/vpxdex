---
import type { Locale } from '../i18n/config';
import { t } from '../i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <div class="footer-brand">
          <span class="brand-mark" aria-hidden="true">V</span>
          <span>{t(lang, 'site.brand')}</span>
        </div>
        <p class="footer-desc">
          {t(lang, 'footer.desc')}
        </p>
      </div>
      <div>
        <h3 class="footer-heading">{t(lang, 'footer.index')}</h3>
        <ul class="footer-list">
          <li><a href={`/${lang}/`}>{t(lang, 'nav.home')}</a></li>
          <li><a href={`/${lang}/#directory`}>{t(lang, 'nav.providers')}</a></li>
          <li><a href={`/${lang}/activities/`}>{t(lang, 'nav.activities')}</a></li>
        </ul>
      </div>
      <div>
        <h3 class="footer-heading">{t(lang, 'footer.about')}</h3>
        <ul class="footer-list">
          <li><a href={`/${lang}/about/`}>{t(lang, 'footer.aboutUs')}</a></li>
          <li><a href={`/${lang}/methodology/`}>{t(lang, 'footer.methodology')}</a></li>
          <li><a href={`/${lang}/disclosure/`}>{t(lang, 'footer.disclosure')}</a></li>
          <li><a href={`/${lang}/contact/`}>{t(lang, 'footer.contact')}</a></li>
        </ul>
      </div>
      <div>
        <h3 class="footer-heading">{t(lang, 'footer.policies')}</h3>
        <ul class="footer-list">
          <li><a href={`/${lang}/privacy/`}>{t(lang, 'footer.privacy')}</a></li>
          <li><a href={`/${lang}/terms/`}>{t(lang, 'footer.terms')}</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      &copy; {currentYear} {t(lang, 'site.brand')} {t(lang, 'footer.rights')}
    </div>
  </div>
</footer>
